LinkedList 類別定義
class LinkedList {
private:
Node* head;
public:
//建構子:初始化空串列
LinkedList(){
head = nullptr;
}
//插入新節點至尾端
void insert(int value){
Node* newNode = new Node (value);
if(head == nullptr) head = newNode;
else{
Node* temp = head;
while(temp->next != nullptr){temp = temp->next;}
temp->next = newNode;
}}
//列印整個串列
void print(){
Node* temp = head;
while(temp!=nullptr){
std::cout<<temp->data<<" -> ";
temp = temp->next;
}
std::cout<<" NULL "<<std::endl;
}
//釋放記憶體
~Linkedlist(){
Node* current = head;
while(current!=nullptr){
Node* nextNode = current->next;
delete current;
current = nextNode;
}}
};
